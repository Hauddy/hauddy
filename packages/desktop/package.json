{
  "name": "@hauddy/desktop",
  "version": "0.1.15",
  "private": true,
  "description": "Electron shell for the hauddy local app: macOS menu-bar tray, compact popover, expandable full window. UI is @hauddy/app-ui.",
  "homepage": "https://hauddy.com",
  "author": {
    "name": "Hauddy",
    "email": "hello@hauddy.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bundle-daemon": "node scripts/bundle-daemon.mjs",
    "build": "npm run build -w @hauddy/app-ui && node scripts/make-icons.mjs && node scripts/bundle-daemon.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "sharp": "^0.33.5",
    "typescript": "~5.5.4"
  },
  "build": {
    "appId": "dev.hauddy.app",
    "productName": "hauddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app"
      },
      {
        "from": "daemon-bundle",
        "to": "daemon"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Hauddy",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 390,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hauddy"
    },
    "asar": true,
    "npmRebuild": false
  }
}
