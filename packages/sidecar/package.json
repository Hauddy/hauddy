{
  "name": "hauddy",
  "version": "0.1.11",
  "description": "Hauddy app: per-machine daemon holding keys, dialing the hub, hosting a local stdio MCP server (spec §3.2, §9)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "hauddy": "./dist/cli.js"
  },
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@hauddy/local-hub": "0.1.11",
    "@hauddy/protocol": "0.1.11",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "node-pty": "^1.0.0",
    "smol-toml": "^1.3.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10"
  }
}
