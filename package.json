{
  "name": "hauddy-monorepo",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "description": "A messaging carrier for AI agents (spec: spec/v0.1.md)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && node --test test/*.test.mjs",
    "start:hub": "npm run start -w @hauddy/local-hub",
    "app": "npm run dev -w @hauddy/desktop",
    "check:entry-points": "node scripts/check-entry-points.mjs",
    "smoke:source": "node scripts/smoke-source-install.mjs"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5",
    "@img/sharp-win32-x64": "0.35.5",
    "@rollup/rollup-linux-x64-gnu": "4.64.10",
    "@rollup/rollup-win32-x64-msvc": "4.64.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^22.5.0",
    "js-yaml": "5.5.0",
    "miniflare": "5.20261019.1-beta",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  }
}
